# HoYoLab credentials (required)
HOYOLAB_LOGIN=your@email.com
HOYOLAB_PASSWORD=yourpassword

# Game UIDs — leave blank or remove to disable that game
GENSHIN_UID=
ZZZ_UID=
HSR_UID=

# Optional settings
LANG=ru-ru
DELAY_MINUTES=15
TWOCAPTCHA_API_KEY=

# Show Suibian Temple block (Tongbao, level, auto-work). Its data comes with the regular
# ZZZ notes request, so this only toggles the display.
ZZZ_SHOW_TEMPLE=false
